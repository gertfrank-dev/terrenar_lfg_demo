# Copia este archivo como .env solo si quieres probar con Postgres o Discord en tu computador.
DEBUG=1
DJANGO_SECRET_KEY=cambia-esto
# Supabase > Connect > Session pooler (funciona en redes solo IPv4, como Render):
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DISCORD_CLIENT_ID=
DISCORD_SECRET=
